# Base URL for the OCR proxy endpoint.
# This is the ROOT URL: do NOT append /v1. The backend derives
# /running, /upstream/{model}/props, and /upstream/{model}/v1 itself.
# This single endpoint is used for:
# - Dedicated OCR model calls
# - Querying currently loaded models (/running)
# - Checking model capabilities (/upstream/{model}/props)
# - Fallback OCR using the current multimodal model
DEEPSEEK_OCR_BASE_URL="http://your-endpoint:8080"

# Optional: path to an alternative OCR routing JSON (defaults to
# ocr_routing.json next to the backend).
# PDF_OCR_ROUTING_CONFIG="/path/to/ocr_routing.json"
